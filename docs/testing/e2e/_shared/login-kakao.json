{
  "name": "카카오 로그인",
  "description": "거의 모든 시나리오의 전제. 소셜 계정은 한 번 가입하면 provider 식별자로 붙어 첫 로그인 경로를 다시 탈 수 없으므로 reset이 함께 있어야 한다.",
  "reset": {
    "device": "pm clear",
    "server": "./server/tool/reset_test_account.sh --provider KAKAO"
  },
  "steps": [
    {
      "screen": "시작",
      "do": "tap '시작하기'",
      "expect_screen": "로그인 — 카카오·네이버·구글 버튼 3개",
      "expect_device": [
        "elum.refreshToken = null",
        "onboardingCompleted = false"
      ],
      "expect_server": null,
      "human": null
    },
    {
      "screen": "로그인",
      "do": "tap '카카오로 시작하기'",
      "expect_screen": "카카오 계정 로그인 (CustomTabs)",
      "expect_device": null,
      "expect_server": null,
      "human": "2단계 인증이 뜨면 카카오톡에서 확인 버튼을 눌러달라고 요청한다 (제한 5분)"
    },
    {
      "screen": "카카오 동의",
      "do": "tap 'Continue'",
      "expect_screen": "약관 동의 — 필수 4개 + 선택 1개",
      "expect_device": [
        "elum.refreshToken 저장됨",
        "lastLoginProvider = kakao"
      ],
      "expect_server": "select username, login_count from member m join auth_identity ai on ai.member_id=m.id where ai.provider='KAKAO'",
      "human": null
    }
  ]
}
