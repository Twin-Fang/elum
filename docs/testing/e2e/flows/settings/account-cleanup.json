{
  "name": "설정에서 로그아웃·회원탈퇴가 약속대로 동작하는지",
  "description": "되돌릴 수 없는 동작이라 실패를 숨기면 사용자가 알 방법이 없다. 서버가 닿지 않는 상황을 일부러 만들어 앱이 무엇을 말하는지 본다.",
  "precondition": "_shared/login-kakao",
  "reset": {
    "device": "pm clear kr.twinfang.elum",
    "server": "server/tool/reset_test_account.sh --provider GOOGLE"
  },
  "steps": [
    {
      "screen": "보호자 홈",
      "do": "tap 우상단 톱니 (798,180)",
      "expect_screen": "설정 — 로그아웃 / 회원탈퇴 두 줄",
      "expect_device": [],
      "expect_server": null,
      "human": null
    },
    {
      "screen": "설정",
      "do": "tap '회원탈퇴' (540,824)",
      "expect_screen": "확인 시트 — 무엇이 사라지는지 알린다",
      "expect_device": [],
      "expect_server": null,
      "human": null
    },
    {
      "screen": "확인 시트",
      "do": "cmd connectivity airplane-mode enable 후 tap '탈퇴하기' (782,2154)",
      "expect_screen": "실패를 알리는 안내가 보여야 한다 (E-DEL)",
      "expect_device": [
        "elum.refreshToken 삭제"
      ],
      "expect_server": "reset_test_account.sh --list 로 계정이 남아있는지 확인",
      "human": null
    },
    {
      "screen": "로그인",
      "do": "cmd connectivity airplane-mode disable 후 같은 계정으로 재로그인",
      "expect_screen": "탈퇴가 실제로 됐다면 온보딩부터. 안 됐다면 홈 — 어느 쪽인지로 3단계 안내가 맞았는지 판정한다",
      "expect_device": [
        "onboardingCompleted"
      ],
      "expect_server": null,
      "human": "구글 2단계 인증이 뜨면 사용자가 눌러야 한다"
    },
    {
      "screen": "설정",
      "do": "tap '로그아웃' → 확인",
      "expect_screen": "로그인 화면",
      "expect_device": [
        "elum.refreshToken 삭제",
        "childNickname 삭제"
      ],
      "expect_server": null,
      "human": null
    }
  ],
  "conditions": [
    {
      "name": "큰 글씨",
      "apply": "settings put system font_scale 1.3",
      "revert": "settings put system font_scale 1.0"
    },
    {
      "name": "다크모드",
      "apply": "cmd uimode night yes",
      "revert": "cmd uimode night no"
    }
  ]
}
