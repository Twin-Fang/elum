# 이룸(ELUM) 클라이언트 환경변수 예시
#
# 이 파일은 "어떤 키가 필요한지" 알려주는 문서다. 실제 값은 .env에 넣는다.
# .env는 커밋하지 않는다 (.gitignore 등록됨).
#
# 사용법:
#   1. cp .env.example .env
#   2. 아래 값을 환경에 맞게 채운다
#   3. CI/배포용 값은 GitHub Secret CLIENT_ENV_FILE에 .env 전체 내용을 등록한다
#
# 새 키를 추가할 땐 반드시 (1) 이 파일 (2) AppConfig 를 함께 수정한다.

# --- 서버 ---
# 운영: https://api.elum.chuseok22.com
# 로컬: http://localhost:8080
# Android 에뮬레이터에서 로컬 서버를 볼 땐 http://10.0.2.2:8080
ELUM_API_BASE_URL=https://api.elum.chuseok22.com

# 요청 타임아웃 (밀리초). 로컬 LLM 카드 생성은 오래 걸릴 수 있어 넉넉히 둔다.
ELUM_API_CONNECT_TIMEOUT_MS=10000
ELUM_API_RECEIVE_TIMEOUT_MS=60000

# --- TTS (카드 읽어주기) ---
# 기기 내장 음성이 우선이고, 한국어 음성이 없는 기기에서만 이 서버를 쓴다.
ELUM_TTS_BASE_URL=https://ai.suhsaechan.kr/api/flask

# ⚠️ 유출되면 안 되는 값이다. 실제 키는 GitHub Secret(CLIENT_ENV_FILE)로만 관리한다.
#    비워두면 서버 폴백만 꺼지고 기기 음성은 그대로 동작한다.
ELUM_TTS_API_KEY=

# AI DLP 요청 암호화 마스터 시크릿 (서버 application-dev.yml의 elum.aidlp.secret와 동일 값).
# ⚠️ 유출되면 안 되는 값이다. 실제 값은 GitHub Secret(CLIENT_ENV_FILE)로만 관리한다.
#    비어 있으면 클라가 암호화하지 않고 평문 전송 → 서버도 통과(데모 안전).
ELUM_AIDLP_SECRET=

# --- 소셜 로그인 ---
# 각 제공자 콘솔에서 앱을 등록하고 받는다. 절차는 docs/setup/소셜로그인_설정가이드.md.
#
# ⚠️ 여기 값만으로는 로그인이 완성되지 않는다. 카카오·구글은 로그인 후 앱으로 돌아오는
#    URL 스킴을 AndroidManifest.xml·Info.plist에도 넣어야 한다. 그건 빌드 타임 값이라
#    .env로 주입할 수 없다.

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > 네이티브 앱 키
# 앱에 포함되는 공개 값이다(비밀은 Admin 키뿐).
ELUM_KAKAO_NATIVE_APP_KEY=

# 네이버 개발자 센터 > 애플리케이션 > Client ID / Client Secret
# ⚠️ 시크릿이 앱에 들어간다. 네이버 모바일 SDK가 요구하는 구조라 피할 수 없다.
ELUM_NAVER_CLIENT_ID=
ELUM_NAVER_CLIENT_SECRET=
# 네이버 로그인 동의 화면에 뜨는 서비스 이름
ELUM_NAVER_CLIENT_NAME=이룸

# Google Cloud Console > 사용자 인증 정보
# ⚠️ 안드로이드 클라이언트 ID가 아니라 **웹** 클라이언트 ID를 넣는다.
#    안드로이드는 serverClientId에 웹 ID를 넘겨야 ID 토큰이 발급된다.
ELUM_GOOGLE_SERVER_CLIENT_ID=
# iOS 클라이언트 ID
ELUM_GOOGLE_IOS_CLIENT_ID=

# 애플은 .env에 넣을 값이 없다. Xcode의 Sign In with Apple capability만 켜면 된다.

# --- 데모 연출 ---
# AI DLP 처리 최소 노출 시간 (밀리초).
# 응답이 빨라도 보안 처리를 체감시키기 위해 유지한다 (docs/07-mvp-scope.md 데모 안전 수칙).
ELUM_DLP_MIN_DELAY_MS=1500

# 로딩 화면이 결과를 기다리는 최대 시간 (밀리초).
# 넘으면 에러 코드 + 재시도를 보여준다. 무한 로딩을 두지 않는다.
# ELUM_API_RECEIVE_TIMEOUT_MS(60000)보다 짧게 둔다.
ELUM_LOADING_MAX_WAIT_MS=45000

# --- 개발 ---
# 네트워크 로깅. 운영에서는 false.
# ⚠️ true여도 보호자 입력 원문은 절대 로그에 남기지 않는다 (docs 원칙 5번).
ELUM_ENABLE_NETWORK_LOG=true

# 서버 없이 mock 데이터로 동작시킬지 여부.
# ⚠️ 현재 true — 서버 카드 생성이 3회 중 1회 502로 불안정하다(이슈 #34).
#    서버가 안정화되면 false로 되돌린다. 코드는 그대로이며 실행 경로만 바뀐다.
# ⚠️ 아래 세 값은 **개발용 빌드에서만** 동작한다.
# 제출·배포용 APK(`flutter build apk --release`)에서는 이 값과 무관하게 전부 꺼진다.
# 개발용 APK는 `--dart-define=ELUM_BUILD=dev`로 만든다. (scripts/build-apk.sh 참고)

# 개발자 도구 오버레이(플로팅 버튼)를 띄울지.
# 회원삭제·로그 확인·화면 이동을 앱 안에서 할 수 있다.
# ⚠️ 심사자·테스터가 릴리스 빌드로 확인해야 하므로 kDebugMode를 걸지 않았다.
#    정식 출시 전 반드시 false로 바꾼다. (이슈 #13)
ELUM_SHOW_DEV_TOOLS=true

# 온보딩을 건너뛸지 (개발·시연용). 플로팅 버튼에서 런타임 토글 가능.
# 릴리스 빌드(TestFlight·Firebase)에서 true로 설정하면 심사자가 즉시 홈으로 진입할 수 있다.
ELUM_SKIP_ONBOARDING=false

# QA 세션 주입 — 디버그 빌드에서만 동작한다 (kDebugMode).
# 로그인 뒤 화면(역할 선택·온보딩·보호자 홈)을 실기기로 확인할 때, 서버에서 받은
# 토큰을 여기에 넣으면 세션이 있는 상태로 앱이 뜬다. 평소에는 비워 둔다.
# ⚠️ 값을 채운 채로 커밋하지 않는다. .env는 커밋되지 않지만 .env.example은 커밋된다.
ELUM_DEV_ACCESS_TOKEN=
ELUM_DEV_REFRESH_TOKEN=
