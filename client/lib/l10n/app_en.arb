  "routineTemplateCategorySelfCare": "Self-care",
  "routineTemplateCategorySelfCareHint": "Everyday tasks like washing, dressing and eating",
  "routineTemplateCategoryDailyFlow": "Daily flow",
  "routineTemplateCategoryDailyFlowHint": "The big steps from morning to bedtime",
  "routineTemplateCategoryHousehold": "Chores",
  "routineTemplateCategoryHouseholdHint": "Tidying up your own things and space",
