<?xml version="1.0" encoding="utf-8"?>
<!-- 별과 연속 2x2: 루미 > n일 연속 > 별 k개 (가운데 정렬) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/widget_panel_padding">

    <ImageView
        android:id="@+id/widget_lumi_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_lumi_description"
        android:scaleType="fitCenter"
        android:src="@drawable/lumi_streak_flame" />

    <TextView
        android:id="@+id/widget_streak_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_small"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_streak_name"
        android:textColor="@color/widget_text_primary"
        android:textSize="@dimen/widget_text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_star_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/widget_text_secondary"
        android:textSize="@dimen/widget_text_caption"
        android:textStyle="bold" />
</LinearLayout>
