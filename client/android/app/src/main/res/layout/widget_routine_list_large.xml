<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘 일과 목록 대 (4x4): 머리(루미 · 오늘 일과 · 전체 n/m) > 일과 줄 4칸 (제목 · 진행 막대 · k/t · 다 하면 체크) | 일과 없으면 빈 상태 -->
<!-- 줄 칸 id 는 줄마다 따로 (RemoteViews 는 같은 id 중 첫 칸만 찾음) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/widget_panel_padding"
    android:paddingTop="@dimen/widget_routine_list_padding_vertical"
    android:paddingEnd="@dimen/widget_panel_padding"
    android:paddingBottom="@dimen/widget_routine_list_padding_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_lumi_image"
            android:layout_width="@dimen/widget_lumi_header_large"
            android:layout_height="@dimen/widget_lumi_header_large"
            android:contentDescription="@string/widget_lumi_description"
            android:scaleType="fitCenter"
            android:src="@drawable/lumi_cheer" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap_small"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_routine_list_header"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_title"
            android:textStyle="bold" />

        <!-- 전체 n/m (요약 없음·일과 0개면 숨김) -->
        <TextView
            android:id="@+id/widget_count_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip_background"
            android:paddingStart="@dimen/widget_chip_padding_horizontal"
            android:paddingTop="@dimen/widget_chip_padding_vertical"
            android:paddingEnd="@dimen/widget_chip_padding_horizontal"
            android:paddingBottom="@dimen/widget_chip_padding_vertical"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_chip_text"
            android:textSize="@dimen/widget_text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_routine_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap"
        android:orientation="vertical">

    <!-- 줄 1 (없으면 숨김, ElumRoutineListWidget.bindRow) -->
    <LinearLayout
        android:id="@+id/widget_routine_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_routine_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_routine_row_padding_horizontal"
        android:paddingTop="@dimen/widget_routine_row_padding_vertical_large"
        android:paddingEnd="@dimen/widget_routine_row_padding_horizontal"
        android:paddingBottom="@dimen/widget_routine_row_padding_vertical_large">

        <TextView
            android:id="@+id/widget_routine_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_routine_1"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_routine_row_1_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/widget_routine_row_progress_width"
            android:layout_height="@dimen/widget_routine_row_progress_height"
            android:layout_marginStart="@dimen/widget_gap"
            android:indeterminate="false"
            android:max="3"
            android:progress="3"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_routine_row_1_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:maxLines="1"
            android:text="@string/widget_preview_count_done"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_caption"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_routine_row_1_check"
            android:layout_width="@dimen/widget_routine_row_check"
            android:layout_height="@dimen/widget_routine_row_check"
            android:layout_marginStart="@dimen/widget_gap_small"
            android:contentDescription="@string/widget_check_done"
            android:src="@drawable/widget_routine_check"
            android:visibility="visible" />
    </LinearLayout>

    <!-- 줄 2 (없으면 숨김, ElumRoutineListWidget.bindRow) -->
    <LinearLayout
        android:id="@+id/widget_routine_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_small"
        android:background="@drawable/widget_routine_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_routine_row_padding_horizontal"
        android:paddingTop="@dimen/widget_routine_row_padding_vertical_large"
        android:paddingEnd="@dimen/widget_routine_row_padding_horizontal"
        android:paddingBottom="@dimen/widget_routine_row_padding_vertical_large">

        <TextView
            android:id="@+id/widget_routine_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_routine_2"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_routine_row_2_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/widget_routine_row_progress_width"
            android:layout_height="@dimen/widget_routine_row_progress_height"
            android:layout_marginStart="@dimen/widget_gap"
            android:indeterminate="false"
            android:max="3"
            android:progress="2"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_routine_row_2_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:maxLines="1"
            android:text="@string/widget_preview_count"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_caption"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_routine_row_2_check"
            android:layout_width="@dimen/widget_routine_row_check"
            android:layout_height="@dimen/widget_routine_row_check"
            android:layout_marginStart="@dimen/widget_gap_small"
            android:contentDescription="@string/widget_check_done"
            android:src="@drawable/widget_routine_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 줄 3 (없으면 숨김, ElumRoutineListWidget.bindRow) -->
    <LinearLayout
        android:id="@+id/widget_routine_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_small"
        android:background="@drawable/widget_routine_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_routine_row_padding_horizontal"
        android:paddingTop="@dimen/widget_routine_row_padding_vertical_large"
        android:paddingEnd="@dimen/widget_routine_row_padding_horizontal"
        android:paddingBottom="@dimen/widget_routine_row_padding_vertical_large">

        <TextView
            android:id="@+id/widget_routine_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_routine_3"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_routine_row_3_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/widget_routine_row_progress_width"
            android:layout_height="@dimen/widget_routine_row_progress_height"
            android:layout_marginStart="@dimen/widget_gap"
            android:indeterminate="false"
            android:max="2"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_routine_row_3_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:maxLines="1"
            android:text="@string/widget_preview_count_none"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_caption"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_routine_row_3_check"
            android:layout_width="@dimen/widget_routine_row_check"
            android:layout_height="@dimen/widget_routine_row_check"
            android:layout_marginStart="@dimen/widget_gap_small"
            android:contentDescription="@string/widget_check_done"
            android:src="@drawable/widget_routine_check"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 줄 4 (없으면 숨김, ElumRoutineListWidget.bindRow) -->
    <LinearLayout
        android:id="@+id/widget_routine_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_gap_small"
        android:background="@drawable/widget_routine_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_routine_row_padding_horizontal"
        android:paddingTop="@dimen/widget_routine_row_padding_vertical_large"
        android:paddingEnd="@dimen/widget_routine_row_padding_horizontal"
        android:paddingBottom="@dimen/widget_routine_row_padding_vertical_large">

        <TextView
            android:id="@+id/widget_routine_row_4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_routine_1"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_routine_row_4_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/widget_routine_row_progress_width"
            android:layout_height="@dimen/widget_routine_row_progress_height"
            android:layout_marginStart="@dimen/widget_gap"
            android:indeterminate="false"
            android:max="3"
            android:progress="3"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/widget_routine_row_4_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:maxLines="1"
            android:text="@string/widget_preview_count_done"
            android:textColor="@color/widget_text_secondary"
            android:textSize="@dimen/widget_text_caption"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_routine_row_4_check"
            android:layout_width="@dimen/widget_routine_row_check"
            android:layout_height="@dimen/widget_routine_row_check"
            android:layout_marginStart="@dimen/widget_gap_small"
            android:contentDescription="@string/widget_check_done"
            android:src="@drawable/widget_routine_check"
            android:visibility="visible" />
    </LinearLayout>
    </LinearLayout>

    <!-- 빈 상태: 루미 상태 그림 + 한마디 (보호자 "오늘 일과를 만들어 볼까요?" · 이룸이 "오늘은 쉬는 날이에요") -->
    <LinearLayout
        android:id="@+id/widget_routine_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/widget_routine_empty_image"
            android:layout_width="@dimen/widget_lumi_medium"
            android:layout_height="@dimen/widget_lumi_medium"
            android:contentDescription="@string/widget_lumi_description"
            android:scaleType="fitCenter"
            android:src="@drawable/lumi_new_routine" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/widget_gap"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_message_empty_guardian"
            android:textColor="@color/widget_text_primary"
            android:textSize="@dimen/widget_text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
