<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 크래시 수집 기본 꺼짐. 개발자 도구 스위치로만 켬, 운영 빌드는 항상 꺼짐 (CrashReporter, #659) -->
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<false/>
	<!-- 분석 수집 기본 꺼짐. 개발자 도구 스위치로만 켬, 운영 빌드는 항상 꺼짐 (AppAnalytics, #650)
	     DEACTIVATED 가 아니라 ENABLED=false: 런타임 setAnalyticsCollectionEnabled 로 켤 수 있어야 함 -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>
	<!-- 화면 추적은 라우터 한 곳(AnalyticsScreenTracker)만. UIViewController 자동 기록 끔 -->
	<key>FirebaseAutomaticScreenReportingEnabled</key>
	<false/>
	<!-- 광고 식별자 3종 끔: IDFV 수집, 광고 맞춤 신호. IDFA 는 Podfile $FirebaseAnalyticsWithoutAdIdSupport -->
	<key>GOOGLE_ANALYTICS_IDFV_COLLECTION_ENABLED</key>
	<false/>
	<key>GOOGLE_ANALYTICS_DEFAULT_ALLOW_AD_PERSONALIZATION_SIGNALS</key>
	<false/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- 설정 > 이룸 > 언어 목록: 연 언어만 (lib/core/l10n/app_locales.dart openedAppLocales, #527).
	     언어를 열 때 여기·lproj·pbxproj·locales_config.xml 을 함께 더한다 (tool/check_native_locales.dart 가 검사) -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ko</string>
	</array>
	<!-- 홈 화면에 보이는 이름. 한국어만 지원하는 서비스라 한글로 둔다 (이슈 #289). -->
	<key>CFBundleDisplayName</key>
	<string>이룸</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>elum</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- iPhone 은 세로만, iPad 는 네 방향 (이슈 #774).
	     iPad 는 분할 보기를 지원하므로 UIRequiresFullScreen 을 쓰지 않는다. 창 크기는 앱이 폭 등급으로 처리한다. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 카드 그림을 카메라·갤러리 사진으로 바꾼다 (이슈 #456). 없으면 iOS 가 앱을 강제 종료한다.
	     문구는 사용자에게 그대로 보이므로 해요체로 쓴다. -->
	<key>NSCameraUsageDescription</key>
	<string>Elum uses the camera to take a photo to use as a card picture.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Elum uses your photo library to choose a photo to use as a card picture.</string>
	<!-- 소셜 로그인. 값은 ios/Flutter/Secrets.xcconfig가 채운다
	     (tool/gen_ios_secrets.sh가 .env로 생성, 커밋 제외). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- 카카오: "kakao" + 네이티브 앱 키 -->
				<string>$(ELUM_KAKAO_SCHEME)</string>
				<!-- 네이버: 개발자센터에 등록한 URL Scheme과 같아야 한다 -->
				<string>elum</string>
				<!-- 구글: iOS 클라이언트 ID를 뒤집은 값 -->
				<string>$(ELUM_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<!-- 다른 앱 설치 여부를 묻기 위한 선언. 없으면 카카오톡·네이버앱이 깔려 있어도
	     감지하지 못하고 항상 웹 로그인으로 빠진다. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
		<string>naversearchapp</string>
		<string>naversearchthirdlogin</string>
	</array>
	<key>NidUrlScheme</key>
	<string>elum</string>
	<key>NidClientID</key>
	<string>$(ELUM_NAVER_CLIENT_ID)</string>
	<key>NidClientSecret</key>
	<string>$(ELUM_NAVER_CLIENT_SECRET)</string>
	<key>NidAppName</key>
	<string>$(ELUM_NAVER_CLIENT_NAME)</string>
	<!-- AdMob 앱 ID. 값은 ios/Flutter/Secrets.xcconfig가 채운다(비면 Google 테스트 앱 ID). -->
	<key>GADApplicationIdentifier</key>
	<string>$(ELUM_ADMOB_APP_ID)</string>
	<!-- 추적 허용 팝업에 뜨는 안내. 이룸이 정보는 쓰지 않는다는 점을 함께 알린다. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This is used to show ads that fit the guardian screen. Elumi's information is not used.</string>
	<!-- Google 권장 SKAdNetwork 식별자. 광고 성과 측정에 쓰여 단가에 영향을 준다. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
