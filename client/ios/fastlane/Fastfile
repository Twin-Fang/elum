# ============================================================
# iOS Fastfile (TestFlight 업로드 + App Store 심사 자동 제출)
# ============================================================
# ★ 이 파일은 마법사(testflight-wizard.py setup)가 ios/fastlane/Fastfile 로 깔며,
#   GitHub Actions 워크플로우(PROJECT-FLUTTER-IOS-TESTFLIGHT.yaml)가 그대로 실행합니다.
#   (Android의 Fastfile.playstore 와 동일한 "깐 파일 = 도는 파일" 구조)
#
# 배포 모드(DEPLOY_MODE) — 공통 네이밍 + iOS 하위호환 별칭 둘 다 인식:
#   store_only    (= testflight_only, 기본) : TestFlight 업로드까지만
#   store_prepare (= appstore_prepare)       : TestFlight + ASC 버전 생성·빌드 선택·What's New 채움(제출 직전)
#   store_submit  (= appstore_submit)        : 위 전부 + 심사 자동 제출(submit_for_review)
#   출시: 심사 통과 즉시 자동 출시
#
# 문구 두 가지는 레포에서 관리한다 (App Store Connect 화면에서 고치면 다음 제출 때 덮인다):
#   '새로운 기능(What's New)' : 워크플로 env STORE_WHATS_NEW_OVERRIDE (비우면 CHANGELOG)
#   심사 메모(Notes)           : ios/fastlane/review_notes.txt (없으면 ASC 기존값 유지)
#
# ⚠️ 신규 앱은 최초 1회 App Store Connect에서 수동 제출이 필요합니다.
#   그 이후 업데이트부터 store_submit으로 완전 자동 제출됩니다.
# ============================================================
default_platform(:ios)

# 심사 제출 취소 후 App Store Connect 반영 대기 (초)
CANCEL_SETTLE_SECONDS = 20

platform :ios do
  desc "TestFlight 업로드 (+ DEPLOY_MODE=store_submit이면 App Store 심사 자동 제출)"
  lane :deploy do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["API_KEY_PATH"]
    )

    app_id = ENV["APP_IDENTIFIER"]
    UI.user_error!("APP_IDENTIFIER(번들 ID) 환경변수가 필요합니다.") if app_id.nil? || app_id.strip.empty?

    deploy_mode = (ENV["DEPLOY_MODE"] || "testflight_only").strip
    prepare_appstore = ["appstore_prepare", "appstore_submit", "store_prepare", "store_submit"].include?(deploy_mode)
    submit_to_appstore = ["appstore_submit", "store_submit"].include?(deploy_mode)
    UI.message("🎛️  배포 모드: #{deploy_mode} (ASC 버전 준비: #{prepare_appstore} / 심사 자동제출: #{submit_to_appstore})")

    # 1) TestFlight 업로드 (항상 수행). ASC 준비/제출 모드면 빌드 처리 완료까지 대기.
    #    ⚠️ Apple Processing(빌드 처리)은 보통 5~15분, 때때로 1시간+ (Apple 서버 사정, 통제 불가).
    #       store_prepare/store_submit은 이 대기에 종속된다. 급할 땐 store_only.
    begin
      pilot(
        api_key: api_key,
        app_identifier: app_id,
        ipa: ENV["IPA_PATH"],
        changelog: ENV["RELEASE_NOTES"],
        skip_waiting_for_build_processing: !prepare_appstore,
        distribute_external: false,
        notify_external_testers: false,
        uses_non_exempt_encryption: false
      )
      puts "✅ TESTFLIGHT 업로드 완료!"
    rescue StandardError => e
      # push 배포가 끝나 같은 빌드가 이미 TestFlight 에 있는데 store_prepare/store_submit 을 다시 돌리면
      # altool 이 같은 빌드번호를 거부한다(ENTITY_ERROR.ATTRIBUTE.INVALID.DUPLICATE, #449).
      # 이때는 업로드를 건너뛰고 아래 ASC 단계로 넘어간다 — deliver 가 build_number 로 올라가 있는 빌드를 고른다.
      # store_only 나 다른 업로드 오류는 그대로 실패시킨다(같은 번호를 두 번 올리는 건 오류이고, 다른 원인을 삼키면 안 된다).
      duplicate = e.message.to_s =~ /INVALID\.DUPLICATE|already been used|must be higher than the previously uploaded/i
      raise unless duplicate && prepare_appstore
      UI.important("⏭️  같은 빌드(#{ENV['BUILD_NUMBER']})가 이미 TestFlight 에 있어 업로드를 건너뛰고 ASC 단계로 넘어갑니다")
    end

    # 2) App Store 버전 준비 (+ store_submit이면 심사 자동 제출)
    if prepare_appstore
      app_ver = ENV["APP_VERSION"]
      # '새로운 기능(What's New)' 문구: STORE_WHATS_NEW_OVERRIDE 가 있으면 그것, 없으면 CHANGELOG(RELEASE_NOTES).
      # 왜 덮어쓰나는 워크플로 env 주석 참고. TestFlight What to Test 는 위 pilot 이 항상 CHANGELOG 를 쓴다.
      default_notes = "버그를 수정하고 안정성을 개선했습니다."
      override_notes = (ENV["STORE_WHATS_NEW_OVERRIDE"] || "").strip
      release_notes = override_notes.empty? ? (ENV["RELEASE_NOTES"] || "").strip : override_notes
      release_notes = default_notes if release_notes.empty?
      UI.message("📝 whatsNew 출처: #{override_notes.empty? ? 'CHANGELOG' : 'STORE_WHATS_NEW_OVERRIDE 덮어쓰기'}")

      # whatsNew 메타를 절대경로로 생성 (상대경로는 fastlane CWD와 어긋나 공란 → 제출 거부).
      # 스토어 문구(이름·부제·키워드·설명, 5개 언어)는 레포 {APP_ROOT}/ios/fastlane/metadata 가 원본 (#1351)
      #   생성: docs/store/build_store_metadata.py · DELIVER_LOCALES(기본 ko)만 whatsNew 를 CHANGELOG 로 덧씀
      workspace = ENV["GITHUB_WORKSPACE"] || Dir.pwd
      metadata_path = File.join(workspace, ENV["APP_ROOT"] || ".", "ios", "fastlane", "metadata")
      require "fileutils"
      # ⚠️ 로케일 디렉토리명은 deliver가 인정하는 코드만 (ko 유효, ko-KR 무효).
      locales = (ENV["DELIVER_LOCALES"] || "ko").split(",").map(&:strip).reject(&:empty?)
      locales.each do |loc|
        dir = File.join(metadata_path, loc)
        FileUtils.mkdir_p(dir)
        File.write(File.join(dir, "release_notes.txt"), release_notes)
      end
      UI.message("📝 whatsNew 메타 작성: #{release_notes}")

      # 심사 메모(Notes)는 ios/fastlane/review_notes.txt 를 원본으로 삼아 매번 그 내용을 넣는다.
      # 이 앱은 심사용 공용 계정이 없어 'Sign-in required'를 일부러 끄고, "Apple로 계속하기"로 로그인하라는
      # 안내를 Notes 에만 둔다. 그 안내가 어긋나면 로그인 문제로 거절되므로 코드와 함께 관리한다.
      # 파일이 없거나 비어 있으면 notes.txt 를 만들지 않아 ASC 기존값을 그대로 둔다. 연락처 등 다른 심사정보는 건드리지 않는다.
      notes_src = File.join(workspace, ENV["APP_ROOT"] || ".", "ios", "fastlane", "review_notes.txt")
      review_dir = File.join(metadata_path, "review_information")
      FileUtils.mkdir_p(review_dir)
      if File.file?(notes_src) && !File.read(notes_src).strip.empty?
        File.write(File.join(review_dir, "notes.txt"), File.read(notes_src).strip)
        UI.message("📝 심사 Notes 작성: #{notes_src}")
      else
        FileUtils.rm_f(File.join(review_dir, "notes.txt"))
        UI.message("⏭️  review_notes.txt 없음 — 심사 Notes는 ASC 기존값 유지")
      end

      UI.message("📂 metadata_path=#{metadata_path}")

      # 심사 자동 제출이면 먼저 심사 대기 중인 옛 제출을 내린다 (대기 중이면 빌드를 못 바꿔 deliver 실패)
      cancel_waiting_review_submissions(app_id: app_id) if submit_to_appstore

      # iPhone 스크린샷 교체 준비: 레포 PNG 있으면 iPhone 세트만 비움 (iPad 유지, #1369)
      #   생성: docs/store/promo/render_store_images.py --to-ios-metadata · 실패하면 이번엔 스크린샷 건너뜀
      screenshots_path = File.join(workspace, ENV["APP_ROOT"] || ".", "ios", "fastlane", "screenshots")
      should_upload_screenshots = clear_iphone_screenshot_sets(
        app_id: app_id, app_version: app_ver, screenshots_path: screenshots_path
      )

      deliver(
        api_key: api_key,
        app_identifier: app_id,
        app_version: app_ver,
        build_number: ENV["BUILD_NUMBER"],
        submit_for_review: submit_to_appstore,
        # 심사 통과 즉시 자동 출시 (Play 관리형 게시 꺼 둔 것과 같음)
        automatic_release: true,
        force: true,
        run_precheck_before_submit: false,
        skip_binary_upload: true,
        skip_metadata: false,
        metadata_path: metadata_path,
        skip_screenshots: !should_upload_screenshots,
        screenshots_path: screenshots_path,
        # 전부 지우는 overwrite 는 iPad 까지 지움 > 끄고 위에서 iPhone 세트만 비움
        overwrite_screenshots: false,
        precheck_include_in_app_purchases: false,
        # 광고 식별자(IDFA) 답변 — 광고 SDK(google_mobile_ads)와 ATT 안내가 들어 있어 "사용함"이어야 한다.
        # false 로 두면 바이너리의 IDFA 참조와 어긋나 심사에서 반려된다(#281).
        # 사용처는 보호자 화면의 광고 게재뿐이고, 설치·행동 추적(어트리뷰션)은 하지 않는다.
        submission_information: {
          add_id_info_uses_idfa: true,
          add_id_info_serves_ads: true,
          add_id_info_tracks_install: false,
          add_id_info_tracks_action: false,
          add_id_info_limits_tracking: true
        }
      )
      if submit_to_appstore
        puts "✅ APP STORE 심사 자동 제출 완료!"
      else
        puts "✅ APP STORE 버전 준비 완료 (Prepare for Submission) — ASC에서 검토 후 'Add for Review'만 누르면 제출됩니다."
      end
    else
      puts "⏭️  store_only(testflight_only) 모드 — App Store 단계 건너뜀 (TestFlight 업로드만 완료)"
    end
  end

  desc "편집 중 버전의 iPhone 스크린샷 세트만 비움 (iPad 유지) > 올려도 되면 true (#1369)"
  private_lane :clear_iphone_screenshot_sets do |options|
    screenshots_path = options[:screenshots_path]
    # iPhone 세트 (6.9형·6.5형): 레포 6.9형으로 교체, 작은 iPhone 은 Apple 이 줄여 씀
    iphone_display_types = %w[APP_IPHONE_67 APP_IPHONE_65]
    # 레포에 PNG 있는 로케일만 대상 (ko, en-US …)
    target_locales = Dir.glob(File.join(screenshots_path, "*"))
                        .select { |dir| File.directory?(dir) && Dir.glob(File.join(dir, "*.png")).any? }
                        .map { |dir| File.basename(dir) }
    if target_locales.empty?
      UI.message("⏭️  스크린샷 없음 — App Store 스크린샷 그대로")
      next false
    end

    begin
      app = Spaceship::ConnectAPI::App.find(options[:app_id])
      UI.user_error!("App Store Connect 에서 앱을 찾지 못했습니다: #{options[:app_id]}") if app.nil?
      platform = Spaceship::ConnectAPI::Platform::IOS
      # 새 버전은 이전 버전 스크린샷을 복사해 생김 > 먼저 만들어 두고 그 안에서 지움
      app.ensure_version!(options[:app_version], platform: platform)
      version = app.get_edit_app_store_version(platform: platform)
      UI.user_error!("편집 중인 버전 없음: #{options[:app_version]}") if version.nil?

      version.get_app_store_version_localizations.each do |localization|
        next unless target_locales.include?(localization.locale)
        localization.get_app_screenshot_sets.each do |screenshot_set|
          next unless iphone_display_types.include?(screenshot_set.screenshot_display_type)
          UI.message("🗑️  iPhone 스크린샷 비움: #{localization.locale} #{screenshot_set.screenshot_display_type}")
          screenshot_set.delete!
        end
      end
      true
    rescue StandardError => e
      # 지우기 실패 상태로 올리면 중복으로 쌓임 > 이번 배포는 스크린샷만 건너뜀 (메타·심사는 계속)
      UI.important("⚠️  iPhone 스크린샷 교체 건너뜀: #{e.message}")
      false
    end
  end

  desc "심사 대기(WAITING_FOR_REVIEW) 중인 제출 취소: 새 빌드로 같은 버전을 다시 제출하기 위함 (#859)"
  private_lane :cancel_waiting_review_submissions do |options|
    app = Spaceship::ConnectAPI::App.find(options[:app_id])
    UI.user_error!("App Store Connect 에서 앱을 찾지 못했습니다: #{options[:app_id]}") if app.nil?

    # 심사 대기 상태만 대상 (심사 중·승인·반려는 건드리지 않음)
    waiting_submissions = app.get_review_submissions(filter: { state: "WAITING_FOR_REVIEW" })
    if waiting_submissions.empty?
      UI.message("⏭️  심사 대기 중인 제출 없음 — 취소 건너뜀")
    else
      waiting_submissions.each do |submission|
        UI.important("🗑️  심사 대기 제출 취소: #{submission.id}")
        submission.cancel_submission
      end
      # 취소가 반영될 때까지 잠시 대기 (바로 deliver 하면 아직 대기 상태로 보일 수 있음)
      sleep(CANCEL_SETTLE_SECONDS)
    end
  end
end
